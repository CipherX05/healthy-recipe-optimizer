# Copy to .env only if you want to change a default. Nothing here is secret:
# this project needs no API key and no database password.

# --- backend (read from the repo-root .env or the process environment) ---
# Where downloads and the SQLite database live. Default: ./data
# RECIPE_DATA_DIR=
# RECIPE_DB_PATH=

# Identification sent when downloading. Keep personal names and e-mail out of it.
# RECIPE_USER_AGENT=recipe-substitution-coursework-importer/1.0

# Seconds between requests to a source (values below 1 are raised to 1).
# RECIPE_REQUEST_DELAY=2.0
# RECIPE_REQUEST_TIMEOUT=180

# Browser origins allowed to call the API directly (comma separated).
# RECIPE_CORS_ORIGINS=http://localhost:3000,http://localhost:4173

# --- frontend ---
# These two are NOT read from this file by default:
#   RECIPE_API_PROXY   set in your shell before `npm run dev` / `npm run preview`
#                      if the API is not at http://127.0.0.1:8000
#   VITE_API_BASE_URL  only for hosting the built app apart from the API;
#                      Vite reads it from .env at build time
